{
  "name": "quickbasket",
  "version": "1.0.0",
  "private": true,
  "description": "QuickBasket - Modern 10-Minute Grocery Delivery Platform",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm run dev",
    "next": "concurrently \"npm run server\" \"npm run next:dev\"",
    "next:dev": "cd nextjs && npm run dev",
    "next:build": "cd nextjs && npm run build",
    "next:start": "cd nextjs && npm run start",
    "seed": "cd backend && npm run seed",
    "build": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
